# =============================================================================
# Vaultwarden - variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores antes de subir a stack:
#   cp .env.example .env
#
# NUNCA versione o arquivo ".env" real (ele já está no .gitignore).
# =============================================================================

# ---------------------------------------------------------------------------
# Versões das imagens (fixe uma versão específica em produção, não use "latest")
# Consulte as tags disponíveis em:
#   https://hub.docker.com/r/vaultwarden/server/tags
#   https://hub.docker.com/_/postgres/tags
# Testado localmente com vaultwarden/server:latest = versão 1.37.1
# ---------------------------------------------------------------------------
POSTGRES_VERSION=16-alpine
VAULTWARDEN_VERSION=latest

# ---------------------------------------------------------------------------
# Banco de dados PostgreSQL
# Gere uma senha forte, por exemplo com:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
POSTGRES_DB=vaultwarden
POSTGRES_USER=vw_user
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_SEM_ESPACOS

# ---------------------------------------------------------------------------
# Domínio público (deve bater com o que está configurado no proxy reverso)
# ---------------------------------------------------------------------------
DOMAIN=https://cofre.rondonopolis.mt.gov.br

# ---------------------------------------------------------------------------
# Token do painel administrativo (/admin)
# Gere o hash Argon2id ANTES de subir os containers (veja DEPLOY.md, passo 4).
# IMPORTANTE: o Docker Compose interpola qualquer "$" que encontrar dentro do
# .env (mesmo em variáveis só usadas via "env_file"). Por isso, TODO "$" do
# hash Argon2id gerado deve ser duplicado para "$$" aqui, senão o valor chega
# corrompido dentro do container. Testado e confirmado nesta stack.
# Exemplo: um hash gerado como
#   $argon2id$v=19$m=65540,t=3,p=4$<salt>$<hash>
# deve ser colado como:
#   $$argon2id$$v=19$$m=65540,t=3,p=4$$<salt>$$<hash>
# Dica: gere já escapado com sed:
#   docker run --rm alpine sh -c "apk add --no-cache argon2 >/dev/null && \
#     echo -n 'SUA_SENHA_ADMIN' | argon2 \"\$(openssl rand -base64 32)\" -e -id -k 65540 -t 3 -p 4" \
#     | sed 's/\$/\$\$/g'
# ---------------------------------------------------------------------------
ADMIN_TOKEN=SUBSTITUA_PELO_HASH_ARGON2ID_GERADO_COM_DOLLAR_DUPLICADO

# ---------------------------------------------------------------------------
# Políticas de cadastro
# Mantenha SIGNUPS_ALLOWED=false em operação normal; habilite temporariamente
# apenas para criar as contas iniciais dos administradores/servidores.
# ---------------------------------------------------------------------------
SIGNUPS_ALLOWED=false
SIGNUPS_VERIFY=true
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
EXTENDED_LOGGING=true
LOG_LEVEL=warn

# ---------------------------------------------------------------------------
# Fuso horário (ajusta timestamps de log)
# ---------------------------------------------------------------------------
TZ=America/Cuiaba

# ---------------------------------------------------------------------------
# SMTP (obrigatório para reset de senha, verificação de e-mail e convites)
# Descomente e preencha com os dados do servidor de e-mail da prefeitura.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.rondonopolis.mt.gov.br
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=cofre@rondonopolis.mt.gov.br
# SMTP_PASSWORD=SUBSTITUA_PELA_SENHA_DO_EMAIL
# SMTP_FROM=cofre@rondonopolis.mt.gov.br
# SMTP_FROM_NAME=Cofre de Senhas - Prefeitura de Rondonópolis
